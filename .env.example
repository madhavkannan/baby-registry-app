# Without these the app runs fully on-device (localStorage), single device
# only. Fill them in to share the list across devices — see
# supabase/README.md. Reuses the same Supabase project as the pregnancy app,
# just a new table, so if that project is already set up you only need to
# run migrations/0001_registry.sql and copy the same URL/key here.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
